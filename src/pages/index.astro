---
import HomeMenu from '../components/HomeMenu.astro';
import { menuItems, site } from '../config/site';
import BaseLayout from '../layouts/BaseLayout.astro';
import '../styles/home.css';
import { Content as AccueilPresentation } from './acceuil-presentation.md';
import { Content as AccueilInformation } from './acceuil-information.md';
import { Content as AccueilCalendrier } from './acceuil-calendrier.md';
---

<BaseLayout showHeader={false}>
  <main class="home">
    <header class="site-heading">
      <h1>{site.home.title}</h1>
      <!-- <h3>{site.home.intro}</h3> -->
    </header>

    <figure class="home-cover">
      <img
        src={site.home.cover.src}
        alt={site.home.cover.alt}
        width={site.home.cover.width}
        height={site.home.cover.height}
        decoding="async"
        fetchpriority="high"
      />
    </figure>

    <section class="home-content-block home-content-block--information">
      <AccueilCalendrier />
    </section>

    <section class="home-content-block home-content-block--presentation">
      <AccueilInformation />
    </section>

    <section class="home-content-block home-content-block--information">
      <AccueilPresentation />
    </section>


    <!-- <HomeMenu items={menuItems} /> -->

  </main>
</BaseLayout>
